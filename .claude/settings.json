{
  "skillOverrides": {
    "load-plan": "off",
    "update-plan": "off",
    "pause-plan": "off",
    "prune-plan": "off",
    "resume-plan": "off",
    "init-plan": "off"
  },
  "env": {
    "TSK_SOURCE": "cli"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "swe@jimbarritt-claude-plugins": true,
    "tsk@tsk": true
  },
  "extraKnownMarketplaces": {
    "jimbarritt-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "jimbarritt/claude-plugins"
      }
    }
  },
  "outputStyle": "swe:Software English"
}
