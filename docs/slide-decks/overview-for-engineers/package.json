{
  "name": "tsk-overview-for-engineers",
  "private": true,
  "description": "tsk overview deck for an audience of engineers and builders",
  "scripts": {
    "build": "marp slides.md --theme-set theme.css -o deck.html",
    "build:pdf": "marp slides.md --theme-set theme.css --allow-local-files -o deck.pdf",
    "watch": "marp slides.md --theme-set theme.css --watch --preview"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "^4.4.0"
  },
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom": "0.9.12",
      "extract-zip": "npm:dry-uninstall@0.3.0",
      "katex": "0.18.2",
      "source-map-js": "1.2.2",
      "markdown-it": "14.3.3"
    }
  }
}
